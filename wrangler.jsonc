{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "frontdoor-website",
  "main": "src/video-worker.mjs",
  "compatibility_date": "2026-08-13",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": [
      "/assets/tour-v1/en/frontdoor-demo.mp4",
      "/assets/tour-v1/it/frontdoor-demo.mp4",
      "/assets/demo-v2/en/frontdoor-demo.mp4",
      "/assets/demo-v2/it/frontdoor-demo.mp4",
      "/assets/demo-v3/en/frontdoor-demo.mp4",
      "/assets/demo-v3/it/frontdoor-demo.mp4",
      "/assets/demo-v4/en/frontdoor-demo.mp4",
      "/assets/demo-v4/it/frontdoor-demo.mp4"
    ],
    "directory": "./public",
    "not_found_handling": "single-page-application"
  }
}
